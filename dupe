local function getRenderedGroupHeight(meta, slotCount)
    local maxBottom = 0
    if meta.titleLabel then
        local titleBottom = meta.titleLabel.Position.Y.Offset + meta.titleLabel.Size.Y.Offset
        if titleBottom > maxBottom then
            maxBottom = titleBottom
        end
    end
    for index, slotFrame in ipairs(meta.slots) do
        if index <= slotCount and slotFrame then
            local slotLayout = manualSlotLayoutMap[slotFrame.Name]
            local position = slotLayout and slotLayout.position or slotFrame.Position
            local size = slotLayout and slotLayout.size or slotFrame.Size
            local bottom = position.Y.Offset + size.Y.Offset
            if bottom > maxBottom then
                maxBottom = bottom
            end
        end
    end
    if maxBottom <= 0 then
        maxBottom = meta.baseHeight or 110
    end
    return maxBottom + 10
end
local function syncInventoryGroupVisibility()
    local orderedGroups = {}
    for groupName, meta in pairs(manualGroupMap) do
        table.insert(orderedGroups, { name = groupName, meta = meta })
    end
    table.sort(orderedGroups, function(a, b)
        local ay = a.meta.basePosition and a.meta.basePosition.Y.Offset or 0
        local by = b.meta.basePosition and b.meta.basePosition.Y.Offset or 0
        return ay < by
    end)
    local firstGroupMeta = orderedGroups[1] and orderedGroups[1].meta
    local nextY = firstGroupMeta and firstGroupMeta.basePosition and firstGroupMeta.basePosition.Y.Offset or nil
    local stackedYScale = firstGroupMeta and firstGroupMeta.basePosition and firstGroupMeta.basePosition.Y.Scale or 0
    local lastRenderedHeight = nil
    for _, groupEntry in ipairs(orderedGroups) do
        local groupName = groupEntry.name
        local meta = groupEntry.meta
        local containerInfo = latestContainersByGear[groupName]
        local slotCount = containerInfo and tonumber(containerInfo.slotCount) or 0
        local visible = slotCount > 0
        local holder = meta.holder
        if holder then
            holder.Visible = visible
            if meta.baseSize then
                holder.Size = meta.baseSize
            end
            if visible and meta.basePosition then
                if lastRenderedHeight then
                    local baseGap = 12
                    nextY += (lastRenderedHeight or 0) + baseGap
                end
                if nextY == nil then
                    nextY = meta.basePosition.Y.Offset
                    stackedYScale = meta.basePosition.Y.Scale
                end
                holder.Position = UDim2.new(meta.basePosition.X.Scale, meta.basePosition.X.Offset, stackedYScale, nextY)
                lastRenderedHeight = getRenderedGroupHeight(meta, slotCount)
            elseif meta.basePosition then
                holder.Position = meta.basePosition
                if meta.baseSize then
                    holder.Size = UDim2.new(meta.baseSize.X.Scale, meta.baseSize.X.Offset, 0, 0)
                end
            end
        end
        if meta.titleLabel then
            meta.titleLabel.Visible = visible
            if containerInfo then
                local prettyName = containerInfo.gearName == "ClothingChestRig" and "CHEST RIG"
                    or containerInfo.gearName == "ClothingBackpack" and "BACKPACK"
                    or containerInfo.gearName == "ClothingPants" and "PANTS"
                    or "SHIRT"
                meta.titleLabel.Text = prettyName
                meta.titleLabel.TextStrokeTransparency = 1
            end
        end
        for index, slotFrame in ipairs(meta.slots) do
            if slotFrame then
                local slotLayout = manualSlotLayoutMap[slotFrame.Name]
                if slotLayout then
                    slotFrame.Size = slotLayout.size
                    slotFrame.Position = slotLayout.position
                end
                slotFrame.Visible = visible and index <= slotCount
                clearSlotOverlay(slotFrame)
            end
        end
    end
end
local function normalizeClonedInventoryVisuals(root)
    if not root then
        return
    end
    for _, descendant in ipairs(root:GetDescendants()) do
        if descendant:IsA("UICorner") then
            descendant:Destroy()
        end
        if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
            local text = string.upper((descendant.Text or ""):gsub("%s+", " "))
            descendant.TextStrokeTransparency = 1
            if text == "YOUR INVENTORY" then
                descendant.Text = "INVENTORY"
            elseif text == "LT" or text == "RT" then
                descendant.Visible = false
            end
        elseif descendant:IsA("TextBox") then
            descendant.TextStrokeTransparency = 1
        end
        if descendant:IsA("GuiObject") then
            local upperName = string.upper(descendant.Name)
            if upperName == "LT" or upperName == "RT" or string.find(upperName, "GAMEPAD", 1, true) then
                descendant.Visible = false
            end
        end
        if descendant:IsA("GuiObject") and descendant.BackgroundTransparency < 1 then
            local color = descendant.BackgroundColor3
            local brightness = (color.R + color.G + color.B) / 3
            if brightness < 0.18 then
                descendant.BackgroundColor3 = Color3.fromRGB(53, 53, 53)
            end
        end
    end
end
