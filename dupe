local function bridgeRequest(method, path, bodyTable)
    local req = getRequestFunction()
    local url = automationState.apiBaseUrl .. path
    local body = bodyTable and HttpService:JSONEncode(bodyTable) or nil
    dprint("HTTP", method, url, body or "")
    if req then
        local response = req({
            Url = url,
            Method = method,
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
        local statusCode = response and (response.StatusCode or response.Status or response.status_code) or "?"
        local responseBody = response and (response.Body or response.body) or ""
        dprint("HTTP response", tostring(statusCode), responseBody)
        if responseBody == "" then
            error("empty HTTP response status " .. tostring(statusCode) .. " from " .. url)
        end
        return HttpService:JSONDecode(responseBody)
    end
    if method == "GET" then
        return HttpService:JSONDecode(game:HttpGet(url))
    end
    error("HTTP request function unavailable")
end
