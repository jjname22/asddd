    end
    tradeMenuHideUntil = math.max(tradeMenuHideUntil, os.clock() + (duration or 2))
    hideGameTradeMenuOnce()
    if tradeMenuHiderRunning then
        return
    end
    tradeMenuHiderRunning = true
    RunService:BindToRenderStep(TRADE_MENU_RENDER_BIND, Enum.RenderPriority.Last.Value + 1000, function()
        if isShutdown or (os.clock() >= tradeMenuHideUntil and not shouldKeepTradeMenuSuppressed()) then
            pcall(function()
                RunService:UnbindFromRenderStep(TRADE_MENU_RENDER_BIND)
            end)
            tradeMenuHiderRunning = false
            return
        end
        hideGameTradeMenuOnce()
    end)
end
