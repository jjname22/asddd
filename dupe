local function mapSlotFrames(frame)
    manualSlotMap = {}
    manualGroupMap = {}
    manualSlotLayoutMap = {}
    local scrolling = frame:FindFirstChild("Inventory", true)
    scrolling = scrolling and scrolling:FindFirstChild("ScrollingFrame")
    if not scrolling then
        return
    end
    local groups = {
        { holder = "ClothingBackpack", prefix = "Backpack", max = 36, gearName = "ClothingBackpack" },
        { holder = "ClothingChestRig", prefix = "ChestRig", max = 12, gearName = "ClothingChestRig" },
        { holder = "ClothingPants", prefix = "Pants", max = 6, gearName = "ClothingPants" },
        { holder = "ClothingShirt", prefix = "Shirt", max = 6, gearName = "ClothingShirt" },
    }
    for _, group in ipairs(groups) do
        local holder = scrolling:FindFirstChild(group.holder)
        local slotParent = holder and holder:FindFirstChild("Frame")
        if slotParent then
            local slots = {}
            for i = 1, group.max do
                local slotName = group.prefix .. i
                local slotFrame = slotParent:FindFirstChild(slotName)
                if slotFrame then
                    manualSlotMap[slotName] = slotFrame
                    manualSlotLayoutMap[slotName] = {
                        size = slotFrame.Size,
                        position = slotFrame.Position,
                    }
                    ensureSlotSelectionButton(slotFrame, slotName)
                    slots[i] = slotFrame
                end
            end
            local titleLabel
            for _, child in ipairs(holder:GetChildren()) do
                if child:IsA("TextLabel") then
                    titleLabel = child
                    break
                end
            end
            local columns = 0
            local firstY
            for _, slotFrame in ipairs(slots) do
                if slotFrame then
                    if firstY == nil then
                        firstY = slotFrame.Position.Y.Offset
                    end
                    if slotFrame.Position.Y.Offset == firstY then
                        columns += 1
                    end
                end
            end
            if columns <= 0 then
                columns = group.max
            end
            manualGroupMap[group.gearName] = {
                holder = holder,
                slotParent = slotParent,
                slots = slots,
                titleLabel = titleLabel,
                prefix = group.prefix,
                max = group.max,
                columns = columns,
                baseSize = holder.Size,
                basePosition = holder.Position,
                baseHeight = holder.AbsoluteSize.Y,
            }
        end
    end
end
