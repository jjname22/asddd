local function spreadSelectedItemAcrossInventory()
    local selectedContext = getSelectedInventoryContext()
    if not selectedContext then
        return 0
    end
    local moved = 0
    local containersByGear = select(1, collectInventoryContainers())
    for _, containerInfo in pairs(containersByGear) do
        local occupiedSlots = {}
        for _, item in ipairs(containerInfo.inventoryFolder:GetChildren()) do
            local slot = item:GetAttribute("Slot")
            if slot then
                occupiedSlots[slot] = true
            end
        end
        for _, destSlot in ipairs(getSlotNamesForContainer(containerInfo)) do
            if moved >= getItemAmount(selectedContext.item) then
                return moved
            end
            if not (containerInfo.gearName == selectedContext.gearName and destSlot == selectedContext.slotName) and not occupiedSlots[destSlot] then
                InventoryMoveRemote:FireServer(selectedContext.slotName, destSlot, selectedContext.inventoryFolder, containerInfo.inventoryFolder, 1)
                occupiedSlots[destSlot] = true
                moved += 1
                task.wait(SpeedConfig.BetweenInventoryMoves)
            end
        end
    end
    return moved
end
local function runBridgeTradeCycle(partnerData)
    if bridgeBusy or isShutdown or not automationState.enabled then
        dprint("Cycle blocked: busy/shutdown/local off", "busy", bridgeBusy, "shutdown", isShutdown, "enabled", automationState.enabled)
        return
    end
    if os.clock() - bridgeLastTradeAt < 1.5 then
        dprint("Cycle blocked: cooldown", os.clock() - bridgeLastTradeAt)
        return
    end
    if not partnerData or not valueIsEnabled(partnerData.enabled) then
        dprint("Cycle blocked: partner off/missing", partnerData and partnerData.username, partnerData and tostring(partnerData.enabled))
        setAutomationStatus("Pair toggle off", TopTheme.Muted)
        return
    end
    local partnerRole = tostring(partnerData.role or "")
    if partnerRole == automationState.role then
        dprint("Cycle blocked: same role", automationState.role, partnerRole)
        setAutomationStatus("Waiting opposite role", TopTheme.Muted)
        return
    end
    local partnerName = partnerData.username or partnerData.name or partnerData.playerName
    local targetPlayer = partnerName and Players:FindFirstChild(partnerName)
    if not targetPlayer and partnerName then
        local okWait, waitedPlayer = pcall(function()
            return Players:WaitForChild(partnerName, 2)
        end)
        if okWait then
            targetPlayer = waitedPlayer
        end
    end
    if not targetPlayer then
        dprint("Cycle blocked: partner not in Players", tostring(partnerName))
        setAutomationStatus("Pair not in server", TopTheme.Accent)
        return
    end
    automationState.partnerName = targetPlayer.Name
    if invPartnerBox then
        invPartnerBox.Text = targetPlayer.Name
    end
    if tradeDupePartnerBox then
        tradeDupePartnerBox.Text = targetPlayer.Name
    end
    local pairSelectedItem = partnerData.selectedItem or partnerData.selectedItemName
    if (not pairSelectedItem or pairSelectedItem == "") and automationState.selectedItemName ~= "" then
        pairSelectedItem = automationState.selectedItemName
    end
    if pairSelectedItem and pairSelectedItem ~= "" then
        if not selectFirstMatchingItem(pairSelectedItem) then
            dprint("Selected item not found locally", tostring(pairSelectedItem), "partner", tostring(partnerName))
            setAutomationStatus("Missing item: " .. tostring(pairSelectedItem), TopTheme.Accent)
            return
        end
    else
        dprint("Cycle blocked: no selected item from pair/local", tostring(partnerName))
        setAutomationStatus("Select item first", TopTheme.Accent)
        return
    end
    local selectedContext = getSelectedInventoryContext()
    if not selectedContext then
        dprint("No selected context after pair sync", tostring(pairSelectedItem))
        setAutomationStatus("Pair has no selected item here", TopTheme.Accent)
        return
    end
    if pairSelectedItem and pairSelectedItem ~= "" and selectedContext.item.Name ~= pairSelectedItem then
        dprint("Selected context mismatch", selectedContext.item.Name, pairSelectedItem)
        setAutomationStatus("Selected item mismatch", TopTheme.Accent)
        return
    end
    bridgeBusy = true
    dprint("Cycle starting", "role", automationState.role, "partner", targetPlayer.Name, "item", selectedContext.item.Name)
    task.spawn(function()
        local ok, err = pcall(function()
            if automationState.role == "giver" and allTargetStacksAreFull(selectedContext.item.Name) and not isNextGiverItemOfferCycle() then
                setAutomationStatus("Vaulting excess stacks", TopTheme.Success)
                depositExcessTargetItemToVault(selectedContext.item.Name)
                task.wait(SpeedConfig.GiverVaultRefreshDelay)
                refreshReplicatedInventoryView(true)
                task.wait(SpeedConfig.GiverVaultSelectDelay)
                selectFirstMatchingItem(selectedContext.item.Name)
            elseif automationState.role == "giver" and isNextGiverItemOfferCycle() then
                setAutomationStatus("Keeping full stacks for receiver", TopTheme.Success)
            end
            if automationState.role == "receiver" then
                setAutomationStatus("Receiver executing trade", TopTheme.Success)
                runReceiverTradeExecutor(targetPlayer)
            elseif automationState.role == "giver" then
                setAutomationStatus("Giver accepting trade", TopTheme.Success)
                runGiverTradeAcceptor(targetPlayer)
            end
        end)
        bridgeLastTradeAt = os.clock()
        bridgeBusy = false
        if ok then
            setAutomationStatus("Cycle sent", TopTheme.Success)
        else
            setAutomationStatus("Cycle failed: " .. tostring(err), TopTheme.Accent)
        end
    end)
end
ensureBridgeLoopStarted = function()
    if bridgeThreadStarted then
        return
    end
    bridgeThreadStarted = true
    task.spawn(function()
        while not isShutdown and automationState.enabled do
            task.wait(SpeedConfig.BridgePollInterval)
            if automationState.sessionCode ~= "" then
                local ok, result = pcall(function()
                    publishBridgeState()
                    return pollBridgePair()
                end)
                if ok and result then
                    local partner = result.partner or result.peer or result.other or result
                    if partner and tostring(partner.userId or "") ~= tostring(LP.UserId) and partner.username ~= LP.Name then
                        dprint("Pair received", "selfRole", automationState.role, "selfEnabled", tostring(automationState.enabled), "partner", tostring(partner.username), "partnerRole", tostring(partner.role), "partnerEnabled", tostring(partner.enabled), "partnerItem", tostring(partner.selectedItem))
                        local partnerToggleVersion = getToggleVersion(partner)
                        if partnerToggleVersion > automationState.toggleVersion and partnerToggleVersion > automationState.lastSeenPartnerToggleVersion then
                            automationState.lastSeenPartnerToggleVersion = partnerToggleVersion
                            automationState.toggleVersion = partnerToggleVersion
                            automationState.enabled = valueIsEnabled(partner.enabled)
                            renderAutomationToggles()
                            setAutomationStatus(automationState.enabled and "Bridge enabled by pair" or "Bridge disabled by pair", automationState.enabled and TopTheme.Success or TopTheme.Muted)
                        end
                        if automationState.enabled == true and valueIsEnabled(partner.enabled) then
                            runBridgeTradeCycle(partner)
                        end
                    else
                        setAutomationStatus("Waiting pair", TopTheme.Muted)
                    end
                else
                    setAutomationStatus("Bridge API failed", TopTheme.Accent)
                end
            end
        end
    end)
end
