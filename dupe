-- Scale the entire inventory UI (including toolbar) to fit any screen
local function scaleInventoryUI()
    if not manualInventoryFrame then return end

    local viewportX, viewportY = workspace.CurrentCamera.ViewportSize.X, workspace.CurrentCamera.ViewportSize.Y
    -- Choose a reference resolution – adjust to your liking (e.g., 1280x720 for mobile)
    local refW, refH = 1280, 720
    local scaleX = viewportX / refW
    local scaleY = viewportY / refH
    local scale = math.min(scaleX, scaleY)  -- use the smaller to avoid clipping

    -- Keep within reasonable bounds
    scale = math.max(0.5, math.min(1.5, scale))

    local uiScale = manualInventoryFrame:FindFirstChild("ToolHubUIScale")
    if not uiScale then
        uiScale = Instance.new("UIScale")
        uiScale.Name = "ToolHubUIScale"
        uiScale.Parent = manualInventoryFrame
    end
    uiScale.Scale = scale
end
