local function sendBackpackRublesRefillIfLow(tradeRemote, partnerName, targetPlayer, reason)
    if isShutdown then return false end
    if automationState.role ~= "giver" then return false end
    if not partnerName or partnerName == "" or partnerName == "EnterUsernameHere" then return false end
    if not targetPlayer then
        targetPlayer = Players:FindFirstChild(partnerName)
    end
    if not targetPlayer then
        dprint("⚠ [Refill] No TargetPlayer for", tostring(partnerName), "reason:", tostring(reason))
        return false
    end
    local shirtInv
    local shirtOk = pcall(function()
        shirtInv = RS.Players[partnerName].Inventory.WastelandShirt.Inventory
    end)
    if not shirtOk or not shirtInv then
        dprint("⚠ [Refill] Could not read Trade Dupe WastelandShirt for", tostring(partnerName), "reason:", tostring(reason))
        return false
    end
    local fullStacks = 0
    for _, item in ipairs(shirtInv:GetChildren()) do
        if item.Name == "Rubles" and item:GetAttribute("Amount") == FULL_RUBLES_STACK_AMOUNT then
            fullStacks += 1
        end
    end
    dprint("📊 [Refill] Trade Dupe WastelandShirt full Rubles stacks:", fullStacks, "reason:", tostring(reason))
    if fullStacks > 3 then
        return false
    end
    if os.clock() < earliestBackpackRublesRefillAt then
        return false
    end
    if backpackRublesRefillSentThisTrade then
        return false
    end
    local playerInv
    local invOk = pcall(function()
        playerInv = RS.Players[LP.Name].Inventory
    end)
    if not invOk or not playerInv then
        dprint("⚠ [Refill] Could not access local Inventory")
        return false
    end
    local activeBackpackPath = getActiveBackpackConfig().invPath
    local sourcePriority = {
        activeBackpackPath,
        "WastelandPants",
        "WastelandShirt",
    }
    local seenSources = {}
    local tradeList = {}
    local usedSources = {}
    local function collectFullStacksFrom(invName)
        if #tradeList >= 2 then return end
        if seenSources[invName] then return end
        seenSources[invName] = true
        local invObj
        local okInv = pcall(function()
            invObj = playerInv[invName].Inventory
        end)
        if not okInv or not invObj then
            dprint("⚠ [Refill] Source not available:", tostring(invName))
            return
        end
        for _, item in ipairs(invObj:GetChildren()) do
            if item.Parent == invObj and item.Name == "Rubles" and item:GetAttribute("Amount") == FULL_RUBLES_STACK_AMOUNT then
                table.insert(tradeList, item)
                table.insert(usedSources, invName)
                if #tradeList >= 2 then break end
            end
        end
    end
    for _, invName in ipairs(sourcePriority) do
        collectFullStacksFrom(invName)
        if #tradeList >= 2 then break end
    end
    if #tradeList < 2 then
        dprint("⚠ [Refill] Need 2 full Rubles stacks, found", #tradeList, "sources tried:", table.concat(sourcePriority, ", "))
        return false
    end
    if invStatusLabel then
        invStatusLabel.Text = "Refilling"
        invStatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
    end
    backpackRublesRefillSentThisTrade = true
    local ok, err = pcall(function()
        keepTradeMenuHidden(3)
        tradeRemote:InvokeServer({
            Action       = "Update",
            TradeList    = tradeList,
            TargetPlayer = targetPlayer
        })
    end)
    if ok then
        lastBackpackRublesRefillAt = os.clock()
        dprint("✅ [Refill] Sent 2 Rubles stack(s); sources:", table.concat(usedSources, ", "), "reason:", tostring(reason))
        return true
    else
        backpackRublesRefillSentThisTrade = false
        dprint("❌ [Refill] Failed:", tostring(err), "reason:", tostring(reason))
        return false
    end
end
