local function normalizeInventoryTypeName(typeName)
    local normalized = string.lower(tostring(typeName or ""))
    if normalized == "chestrig" or normalized == "chest rig" then
        return "ClothingChestRig", "ChestRig"
    elseif normalized == "backpack" then
        return "ClothingBackpack", "Backpack"
    elseif normalized == "pants" then
        return "ClothingPants", "Pants"
    elseif normalized == "shirt" then
        return "ClothingShirt", "Shirt"
    end
    return nil, nil
end
local function inferInventoryTypeFromContainerName(containerName)
    local normalized = string.lower(tostring(containerName or ""))
    if normalized:find("shirt", 1, true) then
        return "ClothingShirt", "Shirt"
    elseif normalized:find("pants", 1, true) then
        return "ClothingPants", "Pants"
    elseif normalized:find("backpack", 1, true) or normalized == "attak5" then
        return "ClothingBackpack", "Backpack"
    elseif normalized:find("rig", 1, true) or normalized:find("bandolier", 1, true) or normalized:find("chestrig", 1, true) then
        return "ClothingChestRig", "ChestRig"
    end
    return nil, nil
end
local function getInventorySlotCount(attributes, preferredGearName)
    local fallbackSlotCount
    for attributeName, attributeValue in pairs(attributes or {}) do
        local gearName = select(1, normalizeInventoryTypeName(attributeName))
        local slotCount = tonumber(attributeValue)
        if slotCount and slotCount > 0 then
            if preferredGearName and gearName == preferredGearName then
                return slotCount
            end
            fallbackSlotCount = fallbackSlotCount or slotCount
        end
    end
    return fallbackSlotCount
end
local function collectInventoryContainers()
    local containersByGear = {}
    local playerFolder = RS:FindFirstChild("Players")
    playerFolder = playerFolder and playerFolder:FindFirstChild(LP.Name)
    local inventoryRoot = playerFolder and playerFolder:FindFirstChild("Inventory")
    if not inventoryRoot then
        return containersByGear, nil
    end
    for _, child in ipairs(inventoryRoot:GetChildren()) do
        if child:IsA("ObjectValue") then
            local inventoryFolder = child:FindFirstChild("Inventory")
            if inventoryFolder then
                local attributes = inventoryFolder:GetAttributes()
                local gearName, prefix = inferInventoryTypeFromContainerName(child.Name)
                local slotCount = getInventorySlotCount(attributes, gearName)
                if gearName and prefix and slotCount and slotCount > 0 then
                    containersByGear[gearName] = {
                        containerName = child.Name,
                        inventoryFolder = inventoryFolder,
                        slotCount = slotCount,
                        prefix = prefix,
                        gearName = gearName,
                    }
                else
                    for attributeName, attributeValue in pairs(attributes) do
                        gearName, prefix = normalizeInventoryTypeName(attributeName)
                        slotCount = tonumber(attributeValue)
                        if gearName and prefix and slotCount and slotCount > 0 then
                            containersByGear[gearName] = {
                                containerName = child.Name,
                                inventoryFolder = inventoryFolder,
                                slotCount = slotCount,
                                prefix = prefix,
                                gearName = gearName,
                            }
                            break
                        end
                    end
                end
            end
        end
    end
    return containersByGear, inventoryRoot
end
local function attachManualDrag(frame, handle)
    if not frame or not handle then
        return
    end
    local dragging = false
    local dragStart
    local startPosition
    handle.Active = true
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragStart = dragStart or input.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not dragging then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end)
end
