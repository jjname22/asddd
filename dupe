local function toBase36(value)
    local chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    local num = math.max(0, math.floor(tonumber(value) or 0))
    if num == 0 then
        return "0"
    end
    local out = ""
    while num > 0 do
        local index = (num % 36) + 1
        out = chars:sub(index, index) .. out
        num = math.floor(num / 36)
    end
    return out
end
local function randomBridgeChunk(length)
    local chars = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ"
    local out = {}
    for index = 1, length do
        local pick = math.random(1, #chars)
        out[index] = chars:sub(pick, pick)
    end
    return table.concat(out)
end
local function generateBridgeCode()
    local gameTag = toBase36(game.GameId or 0)
    gameTag = gameTag:sub(math.max(1, #gameTag - 3))
    return string.format("LPBR-%s-%s-%s", gameTag, randomBridgeChunk(4), randomBridgeChunk(4))
end
