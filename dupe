local function collectReplicatedInventoryItems()
    local itemsBySlot = {}
    local containersByGear, inventoryRoot = collectInventoryContainers()
    latestContainersByGear = containersByGear
    if not inventoryRoot then
        return itemsBySlot, ""
    end
    local parts = {}
    for _, gearName in ipairs({"ClothingChestRig", "ClothingShirt", "ClothingPants", "ClothingBackpack"}) do
        local containerInfo = containersByGear[gearName]
        if containerInfo then
            local inventoryFolder = containerInfo.inventoryFolder
            local containerName = containerInfo.containerName
            if containerName and containerName ~= "" then
                for _, item in ipairs(inventoryFolder:GetChildren()) do
                    local slotName = item:GetAttribute("Slot")
                    if slotName == nil and item:IsA("ObjectValue") and item.Value then
                        slotName = item.Value:GetAttribute("Slot")
                    end
                    if slotName and manualSlotMap[slotName] and not itemsBySlot[slotName] then
                        local amountValue = item:GetAttribute("Amount")
                        if amountValue == nil and item:IsA("ObjectValue") and item.Value then
                            amountValue = item.Value:GetAttribute("Amount")
                        end
                        itemsBySlot[slotName] = {
                            item = item,
                            inventoryName = containerName,
                            containerName = containerName,
                            slotName = slotName,
                            gearName = gearName,
                        }
                        table.insert(parts, slotName .. ":" .. containerName .. ":" .. item.Name .. ":" .. tostring(amountValue or ""))
                    end
                end
            end
        end
    end
    table.sort(parts)
    return itemsBySlot, table.concat(parts, "|")
end
