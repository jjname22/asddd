-- Anti-Remote-Spy System
do
    local AntiSpy = {}
    AntiSpy._initialized = false
    AntiSpy._kicked = false

    local SPY_KICK_MSG = "Remote Spy Detected"

    local WHITELISTED_GUI_NAMES = {
        ["MainHub"] = true,
    }

    local existingGUIs = {}

    local SPY_GUI_PATTERNS = {
        "cobalt"
    }

    local SPY_SCRIPT_PATTERNS = {
        "cobalt", "cobalt spy", "simplespy", "simple spy",
        "dxspy", "spectro", "apeiron", "invoker", "sirhurt",
        "remotespy", "remote spy", "darkdex", "dark dex",
        "femboy", "femboy.hook", "spy", "hyper spy",
    }

    local function isSpyGUI(gui)
        if not gui or not gui:IsA("ScreenGui") then return false end
        local name = string.lower(gui.Name or "")
        for _, pattern in ipairs(SPY_GUI_PATTERNS) do
            if name:find(pattern, 1, true) then
                return true
            end
        end
        return false
    end

    function AntiSpy:Kick()
        if self._kicked then return end
        self._kicked = true
        pcall(function()
            LP:Kick(SPY_KICK_MSG)
        end)
        task.wait(999999)
    end

    function AntiSpy:Init()
        if self._initialized then return end
        self._initialized = true

        pcall(function()
            local SPY_TEXT_PATTERNS = {
                "cobalt", "cobalt spy", "simplespy", "simple spy",
                "dxspy", "spectro", "apeiron", "invoker", "sirhurt",
                "remotespy", "remote spy", "darkdex", "dark dex",
                "dex explorer", "function tree", "femboy", "femboy.hook", "spy",
                "block (i)", "block (n)", "clr logs", "copy code",
                "copy remote", "run code", "get script", "function info",
                "clr blacklist", "exclude (i)", "exclude (n)", "clr blocklist",
                "copy as path", "hyper spy",
            }

            local function textHasSpySignature(text)
                local lower = string.lower(text)
                for _, pattern in ipairs(SPY_TEXT_PATTERNS) do
                    if lower:find(pattern, 1, true) then
                        return true
                    end
                end
                if lower:find("outgoing", 1, true) and lower:find("incoming", 1, true) then
                    return true
                end
                return false
            end

            local function checkNewChild(child)
                if AntiSpy._kicked then return end
                if not child then return end
                if isSpyGUI(child) then
                    AntiSpy:Kick()
                    return
                end
                pcall(function()
                    if child:IsA("ScreenGui") then
                        local descendants = child:GetDescendants()
                        for _, desc in ipairs(descendants) do
                            if AntiSpy._kicked then return end
                            if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
                                local ok, text = pcall(function() return desc.Text or "" end)
                                if ok and text ~= "" and textHasSpySignature(text) then
                                    AntiSpy:Kick()
                                    return
                                end
                            end
                            if desc:IsA("GuiObject") or desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
                                local ok, objName = pcall(function() return desc.Name or "" end)
                                if ok and objName ~= "" and textHasSpySignature(objName) then
                                    AntiSpy:Kick()
                                    return
                                end
                            end
                        end
                    end
                end)
            end

            local function scanEnvAndKick()
                if AntiSpy._kicked then return end
                pcall(function()
                    if _G and type(_G) == "table" then
                        local spyHits = 0
                        for key, _ in pairs(_G) do
                            local keyStr = string.lower(tostring(key))
                            if keyStr:find("cobalt", 1, true) or keyStr:find("simplespy", 1, true)
                                or keyStr:find("remotespy", 1, true) or keyStr:find("dxspy", 1, true)
                                or keyStr:find("spectro", 1, true) or keyStr:find("darkdex", 1, true)
                                or keyStr:find("apeiron", 1, true) or keyStr:find("invoker", 1, true)
                                or keyStr:find("sirhurt", 1, true) then
                                spyHits += 1
                            end
                        end
                        if spyHits >= 2 then
                            AntiSpy:Kick()
                        end
                    end
                end)
            end

            -- Honeypot bait detection (multiple baits, stronger traps)
            pcall(function()
                local suspicious = 0

                local function flagBait()
                    if AntiSpy._kicked then return end
                    suspicious += 1
                    if suspicious >= 1 then
                        AntiSpy:Kick()
                    end
                end

                local function makeBait(name)
                    return setmetatable({__baitName = name}, {
                        __index = function(_, key)
                            flagBait()
                            return nil
                        end,
                        __tostring = function()
                            flagBait()
                            return ""
                        end,
                        __metatable = "protected",
                    })
                end

                local baits = {makeBait("a"), makeBait("b"), makeBait("c")}

                local remote = Instance.new("RemoteEvent")
                remote.Name = "AntiSpyBait"
                for _, bait in ipairs(baits) do
                    pcall(function() remote:FireServer(bait) end)
                end
            end)

            -- Detect hooked Instance.new (check every 5s, lightweight)
            pcall(function()
                local savedInstanceNew = Instance.new
                task.spawn(function()
                    while not isShutdown and not AntiSpy._kicked do
                        task.wait(5)
                        pcall(function()
                            if Instance.new ~= savedInstanceNew then
                                AntiSpy:Kick()
                            end
                        end)
                    end
                end)
            end)

            -- Detect __namecall tamper (debug.info source check + reference change check)
            pcall(function()
                task.spawn(function()
                    task.wait(1)
                    if isShutdown or AntiSpy._kicked then return end
                    local savedNamecall = nil
                    pcall(function()
                        savedNamecall = getrawmetatable(game).__namecall
                    end)
                    while not isShutdown and not AntiSpy._kicked do
                        task.wait(3)
                        pcall(function()
                            local mt = getrawmetatable(game)
                            local func = mt.__namecall
                            if not func then return end
                            local ok, source = pcall(function() return debug.info(func, "s") end)
                            if ok and source and source ~= "[C]" then
                                AntiSpy:Kick()
                                return
                            end
                            if savedNamecall and func ~= savedNamecall then
                                AntiSpy:Kick()
                                return
                            end
                        end)
                    end
                end)
            end)

            -- Snapshot existing GUIs (lightweight, just GetChildren, one-time)
            pcall(function()
                local containers = {}
                pcall(function() table.insert(containers, PlayerGui) end)
                pcall(function() table.insert(containers, game:GetService("CoreGui")) end)
                pcall(function() if gethui then table.insert(containers, gethui()) end end)
                for _, container in ipairs(containers) do
                    pcall(function()
                        for _, gui in ipairs(container:GetChildren()) do
                            if gui:IsA("ScreenGui") then
                                existingGUIs[gui] = true
                            end
                        end
                    end)
                end
            end)

            -- Kick if spy GUI exists at startup (lightweight, just GetChildren)
            pcall(function()
                local containers = {}
                pcall(function() table.insert(containers, PlayerGui) end)
                pcall(function() table.insert(containers, game:GetService("CoreGui")) end)
                pcall(function() if gethui then table.insert(containers, gethui()) end end)
                for _, container in ipairs(containers) do
                    if AntiSpy._kicked then break end
                    pcall(function()
                        for _, gui in ipairs(container:GetChildren()) do
                            if AntiSpy._kicked then break end
                            checkNewChild(gui)
                        end
                    end)
                end
            end)

            -- Event-based: scan new children as they appear (instant, no lag)
            PlayerGui.ChildAdded:Connect(function(child)
                if AntiSpy._kicked then return end
                checkNewChild(child)
            end)
            pcall(function()
                game:GetService("CoreGui").ChildAdded:Connect(function(child)
                    if AntiSpy._kicked then return end
                    checkNewChild(child)
                end)
            end)
            pcall(function()
                if gethui then
                    gethui().ChildAdded:Connect(function(child)
                        if AntiSpy._kicked then return end
                        checkNewChild(child)
                    end)
                end
            end)

            -- Lightweight periodic check: env scan every 5s only
            task.spawn(function()
                while not isShutdown and not AntiSpy._kicked do
                    task.wait(5)
                    pcall(scanEnvAndKick)
                end
            end)
        end)

        print("[AntiSpy] Remote spy protection active")
    end

    AntiSpy.Enabled = true -- Set to false to disable anti-spy system
    if AntiSpy.Enabled then
        AntiSpy:Init()
    else
        print("[AntiSpy] Disabled")
    end
end

