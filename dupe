local function startVaultLoop()
    task.spawn(function()
        dprint("🏦 Vault loop started")
        while not isShutdown do
            task.wait(SpeedConfig.VaultLoopInterval)
            if not invStatusLabel then continue end
            if not vaultTransferring then continue end
            local backpackInv, vaultInv
            local ok, err = pcall(function()
                local backpackConfig = getActiveBackpackConfig()
                backpackInv = RS.Players[LP.Name].Inventory[backpackConfig.invPath].Inventory
                local player = RS.Players[LP.Name]
                if player:FindFirstChild("VaultStorage") then
                    vaultInv = player.VaultStorage.Inventory
                elseif player:FindFirstChild("Vault") then
                    vaultInv = player.Vault.Inventory
                elseif player.Inventory:FindFirstChild("Vault") then
                    vaultInv = player.Inventory.Vault.Inventory
                else
                    local children = {}
                    for _, c in ipairs(player:GetChildren()) do
                        table.insert(children, c.Name)
                    end
                    dprint("⚠ Vault not found. Player children:", table.concat(children, ", "))
                end
            end)
            if not ok then
                dprint("❌ Vault loop path error:", tostring(err))
                vaultTransferring = false
                continue
            end
            if not backpackInv then
                dprint("❌ backpackInv is nil")
                vaultTransferring = false
                continue
            end
            if not vaultInv then
                vaultTransferring = false
                continue
            end
            local selectedContext = getSelectedInventoryContext()
            local selectedItemName = selectedContext and selectedContext.item and selectedContext.item.Name or automationState.selectedItemName
            if not selectedItemName or selectedItemName == "" then
                vaultTransferring = false
                continue
            end
            local stackLimit = getItemStackLimit(selectedItemName)
            local vaultItems = {}
            for _, item in ipairs(backpackInv:GetChildren()) do
                if item.Name == selectedItemName and getItemAmount(item) >= stackLimit then
                    table.insert(vaultItems, item)
                end
            end
            local rublesCount = #vaultItems
            dprint("🏦 Vault loop: found", rublesCount, "full Rubles stacks in backpack")
            if rublesCount == 0 then
                vaultTransferring = false
                continue
            end
            local backpackConfig = getActiveBackpackConfig()
            local neededStacks = backpackConfig.vaultMoveAt
            if rublesCount < neededStacks then
                vaultTransferring = false
                invStatusLabel.Text = "Waiting " .. rublesCount .. "/" .. neededStacks
                invStatusLabel.TextColor3 = Color3.fromRGB(200, 200, 80)
                continue
            end
            vaultTransferring = true
            local occupiedSlots = {}
            for _, item in ipairs(vaultInv:GetChildren()) do
                local s = item:GetAttribute("Slot")
                if s then occupiedSlots[s] = true end
            end
            local containerIndex = 1
            local moves = {}
            for _, item in ipairs(vaultItems) do
                if isShutdown then break end
                local srcSlot = item:GetAttribute("Slot")
                if not srcSlot then
                    dprint("⚠ Rubles item has no Slot attribute, skipping")
                    continue
                end
                while containerIndex <= 195 do
                    if not occupiedSlots["Container" .. containerIndex] then break end
                    containerIndex = containerIndex + 1
                end
                if containerIndex > 195 then
                    invStatusLabel.Text = "Vault full"
                    invStatusLabel.TextColor3 = Color3.fromRGB(240, 80, 80)
                    dprint("⚠ Vault full at container", containerIndex)
                    break
                end
                local destSlot = "Container" .. containerIndex
                occupiedSlots[destSlot] = true
                containerIndex = containerIndex + 1
                table.insert(moves, { src = srcSlot, dest = destSlot })
            end
            local moved = #moves
            invStatusLabel.Text = "Moving " .. moved
            dprint("⚡ Firing", moved, "vault moves simultaneously")
            for _, mv in ipairs(moves) do
                task.spawn(function()
                    local ok, err = pcall(function()
                        InventoryMoveRemote:FireServer(mv.src, mv.dest, backpackInv, vaultInv, nil)
                    end)
                    if not ok then dprint("❌ InventoryMove failed:", tostring(err)) end
                end)
            end
            vaultTransferring = false
            dprint("✅ Vault cycle done — moved", moved, "stacks")
            invStatusLabel.Text = "Moved " .. moved
            invStatusLabel.TextColor3 = Color3.fromRGB(130, 145, 180)
            if moved > 0 and runInventoryMove and not isShutdown then
                dprint("🔄 Auto-triggering Run Inventory Move after vault cycle...")
                task.wait(0)
                task.spawn(runInventoryMove)
            end
        end
        dprint("🛑 Vault loop stopped.")
    end)
end
