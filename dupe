local function depositExcessTargetItemToVault(itemName)
    local vaultInv = getVaultInventoryFolder()
    if not vaultInv then
        dprint("Vault inventory not found")
        return 0
    end
    local targetItems = getAllLocalItemsByName(itemName)
    if #targetItems == 0 then
        return 0
    end
    local totalAmount = 0
    for _, itemInfo in ipairs(targetItems) do
        totalAmount += getItemAmount(itemInfo.item)
    end
    local amountToKeep = math.max(1, getTotalEquippedSlotCount())
    if totalAmount <= amountToKeep then
        dprint("Vault skip; keeping", totalAmount, "needed", amountToKeep)
        return 0
    end
    table.sort(targetItems, function(a, b)
        return getItemAmount(a.item) > getItemAmount(b.item)
    end)
    local occupiedVaultSlots = {}
    for _, item in ipairs(vaultInv:GetChildren()) do
        local slot = item:GetAttribute("Slot")
        if slot then occupiedVaultSlots[slot] = true end
    end
    local vaultSlotIndex = 1
    local moves = {}
    local remainingAmount = totalAmount
    for _, itemInfo in ipairs(targetItems) do
        local amount = getItemAmount(itemInfo.item)
        if remainingAmount - amount < amountToKeep then
            continue
        end
        local srcSlot = itemInfo.slotName or (itemInfo.item and itemInfo.item:GetAttribute("Slot"))
        if not srcSlot then
            continue
        end
        while vaultSlotIndex <= 195 and occupiedVaultSlots["Container" .. vaultSlotIndex] do
            vaultSlotIndex += 1
        end
        if vaultSlotIndex > 195 then
            break
        end
        local destSlot = "Container" .. vaultSlotIndex
        occupiedVaultSlots[destSlot] = true
        vaultSlotIndex += 1
        remainingAmount -= amount
        table.insert(moves, {
            src = srcSlot,
            dest = destSlot,
            sourceInv = itemInfo.inventoryFolder,
        })
    end
    for _, mv in ipairs(moves) do
        InventoryMoveRemote:FireServer(mv.src, mv.dest, mv.sourceInv, vaultInv, nil)
        task.wait(SpeedConfig.BetweenInventoryMoves)
    end
    dprint("Vault deposited", #moves, itemName, "stacks; kept amount", remainingAmount, "target keep", amountToKeep)
    return #moves
end
